ENV=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql+asyncpg://overseer:overseer@localhost:55432/overseer

DATABASE_URL_TEST=postgresql+asyncpg://overseer:overseer@localhost:55432/overseer_test

DB_ECHO=false

REDIS_URL=redis://localhost:56379/0

# Активный LLM-провайдер: "anthropic" | "deepseek"
LLM_PROVIDER=deepseek

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_USER=overseer
POSTGRES_PASSWORD=overseer
POSTGRES_DB=overseer
POSTGRES_PORT=55432
REDIS_PORT=56379

# apps/voice — локальный голосовой клиент, ставится отдельной группой: uv sync --group voice
VOICE_WAKE_WORD_PHRASE=hey jarvis
VOICE_WAKE_WORD_MODEL_PATH=
VOICE_WAKE_WORD_THRESHOLD=0.5
VOICE_INPUT_DEVICE=
VOICE_LOG_LEVEL=INFO

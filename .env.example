ENV=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql+asyncpg://overseer:overseer@localhost:55432/overseer

DATABASE_URL_TEST=postgresql+asyncpg://overseer:overseer@localhost:55432/overseer_test

DB_ECHO=false

REDIS_URL=redis://localhost:56379/0

# Redis для тестов. Если не задан, тесты берут REDIS_URL и подставляют соседний номер
# логической базы — рабочий Redis никогда не используется.
REDIS_URL_TEST=redis://localhost:56379/1

# Активный LLM-провайдер: "anthropic" | "deepseek"
LLM_PROVIDER=deepseek

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

API_HOST=0.0.0.0
API_PORT=8000

# Браузер Playwright, ставится отдельной группой:
# uv sync --group browser && uv run playwright install chromium
# BROWSER_HEADLESS=false имеет смысл только вне Docker: дисплея в контейнере нет.
BROWSER_HEADLESS=true
# Песочницу Chromium отключает только образ apps/api — там процесс идёт от root.
BROWSER_NO_SANDBOX=false
BROWSER_IDLE_TTL_SECONDS=600
BROWSER_SWEEP_INTERVAL_SECONDS=60
BROWSER_MAX_SESSIONS=4

POSTGRES_USER=overseer
POSTGRES_PASSWORD=overseer
POSTGRES_DB=overseer
POSTGRES_PORT=55432
REDIS_PORT=56379

# apps/voice — локальный голосовой клиент, ставится отдельной группой: uv sync --group voice
VOICE_WAKE_WORD_PHRASE=hey jarvis
VOICE_WAKE_WORD_MODEL_PATH=
VOICE_WAKE_WORD_THRESHOLD=0.5
VOICE_INPUT_DEVICE=
VOICE_STT_MODEL=small
VOICE_STT_DEVICE=auto
VOICE_STT_COMPUTE_TYPE=int8
VOICE_STT_LANGUAGE=ru
VOICE_VAD_SPEECH_RMS=300.0
VOICE_VAD_SILENCE_S=0.8
VOICE_VAD_START_TIMEOUT_S=3.0
VOICE_VAD_MAX_UTTERANCE_S=30.0
VOICE_TTS_MODEL_URL=https://models.silero.ai/models/tts/ru/v4_ru.pt
VOICE_TTS_MODEL_PATH=
VOICE_TTS_VOICE=xenia
VOICE_TTS_SAMPLE_RATE=24000
VOICE_TTS_DEVICE=cpu
VOICE_OUTPUT_DEVICE=
VOICE_WS_URL=ws://localhost:8000/ws/chat
VOICE_CONVERSATION_ID=
VOICE_WS_RECONNECT_INITIAL_S=1.0
VOICE_WS_RECONNECT_MAX_S=30.0
VOICE_API_URL=
VOICE_CONFIRMATION_ANSWER_TIMEOUT_S=45.0
VOICE_LOG_LEVEL=INFO

ENV=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# Адреса со стороны хоста — 127.0.0.1, а не localhost: порты опубликованы только на
# IPv4-loopback, и localhost сперва пробовал бы ::1.
DATABASE_URL=postgresql+asyncpg://overseer:overseer@127.0.0.1:55432/overseer

DATABASE_URL_TEST=postgresql+asyncpg://overseer:overseer@127.0.0.1:55432/overseer_test

DB_ECHO=false

# Пароль в REDIS_URL и REDIS_URL_TEST — тот же, что REDIS_PASSWORD ниже. Пользователь
# default — встроенный пользователь Redis; отдельных ACL-пользователей пока нет.
REDIS_URL=redis://default:overseer@127.0.0.1:56379/0

# Redis для тестов. Если не задан, тесты берут REDIS_URL и подставляют соседний номер
# логической базы — рабочий Redis никогда не используется.
REDIS_URL_TEST=redis://default:overseer@127.0.0.1:56379/1

# Активный LLM-провайдер: "anthropic" | "deepseek"
LLM_PROVIDER=deepseek

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Вне Docker uvicorn слушает только loopback. В контейнере он слушает 0.0.0.0 сам (CMD
# образа), а наружу порт публикуется только на 127.0.0.1 (OVE-61).
API_HOST=127.0.0.1
API_PORT=8000
# Bearer-токен API (OVE-61): обязателен, без него api не стартует. Значения по умолчанию
# нет намеренно — сгенерируй свой: openssl rand -hex 32 (не короче 32 символов из
# A-Z a-z 0-9 . _ ~ -). Тот же токен — в VOICE_API_TOKEN ниже.
API_TOKEN=
# Origin браузерных клиентов /ws/chat, JSON-списком, например ["tauri://localhost"].
# Пусто — ни одной браузерной странице подключаться нельзя; нативные клиенты (apps/voice)
# Origin не шлют и проходят по токену.
API_ALLOWED_ORIGINS=[]

# Браузер Playwright, ставится отдельной группой:
# uv sync --group browser && uv run playwright install chromium
# BROWSER_HEADLESS=false имеет смысл только вне Docker: дисплея в контейнере нет.
BROWSER_HEADLESS=true
# Песочницу Chromium не отключаем: она изолирует рендерер, который открывает
# произвольные внешние страницы. true — аварийный выход для окружения, которое
# не даёт поднять пользовательские namespace'ы (см. docker/chromium-seccomp.json).
BROWSER_NO_SANDBOX=false
BROWSER_IDLE_TTL_SECONDS=600
BROWSER_SWEEP_INTERVAL_SECONDS=60
BROWSER_MAX_SESSIONS=4

# Транспорт api → executor (OVE-29/60). Сколько api ждёт, пока executor возьмёт запрос
# (не взял — запрос снимается с очереди, действие не выполнено), и потолок ожидания
# результата: больше 60 с таймаута COM-вызова и не больше 120 с окна контракта.
EXECUTOR_PICKUP_TIMEOUT_S=5.0
EXECUTOR_CALL_BUDGET_S=70.0

# Переменные docker compose. Порты публикуются только на 127.0.0.1 (OVE-59).
# overseer/overseer и пароль Redis overseer — значения для локальной разработки, а не
# секреты: снаружи машины эти порты недоступны. На любой другой машине замени их здесь и
# в DATABASE_URL / REDIS_URL выше, например на `openssl rand -hex 32` — пароль Redis
# должен состоять из URL-безопасных символов. При ENV=prod пароль overseer в DATABASE_URL
# и REDIS_URL отклоняется на старте (OVE-62).
POSTGRES_USER=overseer
POSTGRES_PASSWORD=overseer
POSTGRES_DB=overseer
POSTGRES_PORT=55432
REDIS_PASSWORD=overseer
REDIS_PORT=56379
# Пароль ACL-пользователя Redis overseer-executor (OVE-60). Значения по умолчанию нет
# нигде: пусто — пользователь не заводится, и Redis работает ровно как без executor.
# Нужен только тому, кто запускает apps/executor: не короче 32 символов из
# A-Z a-z 0-9 . _ ~ -, не равен REDIS_PASSWORD (openssl rand -hex 32). Тот же пароль —
# в EXECUTOR_REDIS_URL ниже.
REDIS_EXECUTOR_PASSWORD=

# apps/voice — локальный голосовой клиент, ставится отдельной группой: uv sync --group voice
VOICE_WAKE_WORD_PHRASE=hey jarvis
VOICE_WAKE_WORD_MODEL_PATH=
VOICE_WAKE_WORD_THRESHOLD=0.5
VOICE_INPUT_DEVICE=
VOICE_STT_MODEL=small
VOICE_STT_DEVICE=auto
VOICE_STT_COMPUTE_TYPE=int8
VOICE_STT_LANGUAGE=ru
VOICE_VAD_SPEECH_RMS=300.0
VOICE_VAD_SILENCE_S=0.8
VOICE_VAD_START_TIMEOUT_S=3.0
VOICE_VAD_MAX_UTTERANCE_S=30.0
VOICE_TTS_MODEL_URL=https://models.silero.ai/models/tts/ru/v4_ru.pt
VOICE_TTS_MODEL_PATH=
VOICE_TTS_VOICE=xenia
VOICE_TTS_SAMPLE_RATE=24000
VOICE_TTS_DEVICE=cpu
VOICE_OUTPUT_DEVICE=
VOICE_WS_URL=ws://127.0.0.1:8000/ws/chat
VOICE_CONVERSATION_ID=
VOICE_WS_RECONNECT_INITIAL_S=1.0
VOICE_WS_RECONNECT_MAX_S=30.0
VOICE_API_URL=
# То же значение, что API_TOKEN выше: без него голосовой клиент не стартует (OVE-61).
VOICE_API_TOKEN=
VOICE_CONFIRMATION_ANSWER_TIMEOUT_S=45.0
VOICE_LOG_LEVEL=INFO

# apps/executor — процесс на Windows-машине пользователя (OVE-60), ставится группой:
# uv sync --group executor; запуск: uv run python -m apps.executor.main
# Redis со стороны хоста, отдельным ACL-пользователем overseer-executor с паролем
# REDIS_EXECUTOR_PASSWORD выше; адрес — 127.0.0.1, не localhost. Значения по умолчанию нет:
# пусто — executor не стартует.
EXECUTOR_REDIS_URL=
EXECUTOR_HEARTBEAT_INTERVAL_S=5.0
EXECUTOR_HEARTBEAT_TTL_S=15.0
EXECUTOR_REPLY_TTL_S=60
EXECUTOR_DEDUP_TTL_S=600.0
EXECUTOR_MAX_CALL_S=70.0
# Папки, где executor открывает и сохраняет файлы, JSON-списком абсолютных путей Windows.
# Пусто ([]) — одна папка Documents\Overseer в профиле пользователя, executor создаёт её сам.
EXECUTOR_ALLOWED_ROOTS=[]
EXECUTOR_MAX_CONVERSATIONS=4
EXECUTOR_CONVERSATION_IDLE_TTL_S=1800.0
EXECUTOR_LOG_LEVEL=INFO
